pipeline  {
    agent any

    stages {
        stage('Unit test - Backend') {
            agent {
                docker {
                    image 'golang:1.24-alpine'
                    args '-e GOCACHE=/tmp/go-cache -e GOPATH=/tmp/go-path'
                }
            }
            steps {
                dir('backend') {
                    sh 'go test -v ./...'
                }
            }
        }
    }
}