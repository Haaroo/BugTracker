pipeline  {
    agent any

    stages {
        stage('Unit test - Backend') {
            agent {
                docker {
                    image 'golang:1.24'
                    args '-e GOCACHE=/tmp/go-cache -e GOPATH=/tmp/go-path'
                }
            }
            steps {
                dir('backend') {
                    sh 'go test -v ./...'
                }
            }
        }

        stage('Unit test - Frontend') {
            agent {
                docker {
                    image 'node:20-alpine'
                    reuseNode true
                }
            }
            steps {
                dir('frontend') {
                    sh 'npm ci'
                    sh 'npm test'
                }
            }
            post {
                always {
                    junit 'frontend/test-results/frontend-junit.xml'
                }
            }
        }
    }
}